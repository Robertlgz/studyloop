{
    "name": "studyloop",
    "version": "0.1.0",
    "description": "阅读、查词、复习、Anki 导出、AI 辅助全合一语言学习插件",
    "main": "main.js",
    "scripts": {
        "build": "vite build --mode production",
        "dev": "vite build --mode development",
        "typecheck": "vue-tsc --noEmit --skipLibCheck",
        "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "language-learning",
        "vocabulary",
        "spaced-repetition",
        "anki"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@types/nlcst": "^2.0.3",
        "nlcst-to-string": "^4.0.0",
        "retext-english": "^5.0.0",
        "ts-fsrs": "^5.4.1",
        "unified": "^11.0.5",
        "unist-util-modify-children": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "vue": "^3.5.39"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "obsidian": "^1.11.0",
        "typescript": "~5.9.3",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
